{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas-model-gateway",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "browser": { "binding": "BROWSER" },
  "durable_objects": { "bindings": [{ "name": "NEXORA_BROWSER", "class_name": "NexoraBrowserSession" }] },
  "migrations": [{ "tag": "v1-browser", "new_sqlite_classes": ["NexoraBrowserSession"] }],
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "d1_databases": [{ "binding": "KNOWLEDGE_DB", "database_name": "atlas-knowledge-archive", "database_id": "27a086e4-c14b-4822-9d47-267f68163773", "migrations_dir": "migrations" }],
  "observability": { "enabled": true },
  "previews": {
    "ai": { "binding": "AI" }
  }
}
